datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("worker") // "admin" atau "worker"
  createdAt DateTime @default(now())
}

model Ayam {
  id        Int      @id @default(autoincrement())
  jumlah    Int
  mati      Int
  pakan     Float
  createdAt DateTime @default(now())
}